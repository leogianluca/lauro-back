After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/lauro-refresh-db-credentials.py --secret-arn arn:aws:secretsmanager:us-east-1:450222980470:secret:rds!db-d48d842c-e0e2-4c10-abb5-298626932d41-hSZo0m --db-host lauro-prod-postgres.ccj6cko8cw2q.us-east-1.rds.amazonaws.com --apply
TimeoutStartSec=300

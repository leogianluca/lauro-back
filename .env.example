DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEVISE_JWT_SECRET_KEY=change-me-in-development-and-production

# Production uses the EC2 IAM role; do not configure long-lived AWS keys.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_BUCKET_DEVELOPMENT=
AWS_S3_BUCKET_STAGING=
AWS_S3_BUCKET_PRODUCTION=
AWS_CLOUDFRONT_HOST=
ACTIVE_STORAGE_SERVICE=amazon

MAILER_DELIVERY_METHOD=smtp
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_FROM=contato@example.com
NEWSLETTER_WEBHOOK_SECRET=replace-with-a-long-random-secret
APP_HOST=localhost
APP_PORT=3000
APP_PROTOCOL=http
APP_PUBLIC_URL=http://localhost:3000
